{
  "schema_version": 1,
  "description": "LivingMemory 默认敏感词表。首次运行时复制到数据目录的 privacy_lexicon.json，可直接编辑并热加载；也可通过 LIVINGMEMORY_PRIVACY_LEXICON 指定路径。每条规则包含分组、等级(0-3)、mask_policy 与替换泛称。",
  "categories": [
    {
      "name": "id_document",
      "policy": "id",
      "sensitivity": 3,
      "replacement": "证件信息",
      "keywords": ["身份证", "身份证号", "证件号", "护照号", "户口本", "户口簿", "社保号", "社保卡号", "学籍号", "居住证"],
      "patterns": ["(身份证|证件)(号)?[：: ]*[\\dXx]{6,18}"]
    },
    {
      "name": "vehicle_plate",
      "policy": "plate",
      "sensitivity": 2,
      "replacement": "一辆车",
      "keywords": ["车牌号", "车牌", "牌照"],
      "patterns": ["(车牌|牌照)[：: ]*[\\u4e00-\\u9fa5A-Za-z0-9]{5,8}"]
    },
    {
      "name": "account_credential",
      "policy": "account",
      "sensitivity": 3,
      "replacement": "账号密码",
      "keywords": ["密码", "登录密码", "支付密码", "验证码", "动态码", "私钥", "密钥", "助记词", "token", "cookie", "cookies"],
      "patterns": []
    },
    {
      "name": "bank_account",
      "policy": "account",
      "sensitivity": 3,
      "replacement": "那张卡",
      "keywords": ["银行卡", "银行卡号", "信用卡", "信用卡号", "卡号", "开户行"],
      "patterns": ["(银行卡|卡号)[：: ]*\\d{6,20}"]
    },
    {
      "name": "account_identifier",
      "policy": "account",
      "sensitivity": 2,
      "replacement": "那个账号",
      "keywords": ["微信号", "QQ号", "微博号", "抖音号", "快手号", "小红书号", "账号ID", "UID"],
      "patterns": ["(QQ|微信)(号)?[：: ]*[\\w-]{5,20}", "\\bUID[：: ]*\\d{4,}"]
    },
    {
      "name": "address",
      "policy": "address",
      "sensitivity": 2,
      "replacement": "家附近",
      "keywords": ["住址", "家庭住址", "门牌号", "小区", "单元楼", "出租屋", "宿舍楼"],
      "patterns": ["[\\u4e00-\\u9fa5]{1,2}[省市]?[\\u4e00-\\u9fa5]{2,8}(小区|花园|公寓)"]
    },
    {
      "name": "contact",
      "policy": "contact",
      "sensitivity": 2,
      "replacement": "联系方式",
      "keywords": ["手机号", "手机号码", "电话号码", "联系电话", "邮箱", "电子邮箱"],
      "patterns": ["1[3-9]\\d{9}", "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"]
    },
    {
      "name": "amount",
      "policy": "amount",
      "sensitivity": 2,
      "replacement": "不少钱",
      "keywords": ["金额", "转账", "红包", "账单"],
      "patterns": ["\\d{3,}[\\d,]*\\s*元", "\\d+(\\.\\d+)?\\s*万"]
