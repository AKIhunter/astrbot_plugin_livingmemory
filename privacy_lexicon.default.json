    },
    {
      "name": "contact",
      "policy": "contact",
      "sensitivity": 2,
      "replacement": "联系方式",
      "keywords": ["手机号", "手机号码", "电话号码", "联系电话", "邮箱", "电子邮箱"],
      "patterns": ["(?<!\\d)1[3-9]\\d[ -]?\\d{4}[ -]?\\d{4}(?!\\d)", "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"]
