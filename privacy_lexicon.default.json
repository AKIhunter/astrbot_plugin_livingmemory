      "patterns": ["(?<![A-Za-z0-9_])(?:QQ|微信)[是为:=\\s]+[A-Za-z0-9_-]{5,}"],
      "keyword_patterns": ["{{keyword}}[是为:=\\s]+[A-Za-z0-9_-]+"]
