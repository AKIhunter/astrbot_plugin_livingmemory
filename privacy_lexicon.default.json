{
  "schema_version": 1,
  "description": "LivingMemory 默认敏感词表。首次运行时复制到数据目录的 privacy_lexicon.json，可直接编辑并热加载；也可通过 LIVINGMEMORY_PRIVACY_LEXICON 指定路径。每条规则包含分组、等级(0-3)、mask_policy 与替换泛称。",
  "normalization": {
    "unicode_form": "NFKC",
    "character_map": {
      "證": "证", "號": "号", "護": "护", "碼": "码", "賬": "账", "帳": "账",
      "戶": "户", "銀": "银", "聯": "联", "繫": "系", "郵": "邮", "額": "额",
      "轉": "转", "幣": "币", "塊": "块", "萬": "万", "單": "单", "棟": "栋",
      "門": "门", "區": "区", "樓": "楼", "陰": "阴", "經": "经", "圍": "围",
      "處": "处", "雙": "双", "戀": "恋", "櫃": "柜", "別": "别", "無": "无",
      "鬱": "郁", "憂": "忧", "慮": "虑", "癥": "症", "礙": "碍", "藥": "药",
      "賴": "赖", "賭": "赌", "癮": "瘾", "網": "网", "貸": "贷", "債": "债",
      "負": "负", "務": "务", "還": "还", "訊": "讯", "錄": "录", "訴": "诉",
      "訟": "讼", "紛": "纷", "糾": "纠", "勞": "劳", "動": "动", "親": "亲",
      "閨": "闺", "媽": "妈", "爺": "爷"
    }
  },
  "keyword_matching": {
    "separators": " \t\r\n._-·",
    "max_separator_run": 2,
    "ascii_boundaries": true
  },
  "matching_notes": "仅匹配视图逐码点NFKC及有限字形映射，原文与未命中片段不改变；不做同音/编辑距离模糊。keyword_patterns的{{keyword}}复用登记词及边界。短ASCII凭据词须赋值语境。新增默认文件不会覆盖已有运行词表，更不会重分级或重索引旧数据。",
  "categories": [
    {
      "name": "id_document",
      "policy": "id",
      "sensitivity": 3,
      "replacement": "证件信息",
      "keywords": ["身份证", "身份证号", "证件号", "护照号", "户口本", "户口簿", "社保号", "社保卡号", "学籍号", "居住证"],
      "patterns": [],
      "keyword_patterns": ["{{keyword}}[是为:=\\s]*(?:[A-Z0-9][ -]?){6,40}"]
    },
    {
      "name": "vehicle_plate",
      "policy": "plate",
      "sensitivity": 2,
      "replacement": "一辆车",
      "keywords": ["车牌号", "车牌", "牌照"],
      "patterns": ["(车牌|牌照)[：: ]*[\\u4e00-\\u9fa5A-Za-z0-9]{5,8}"]
    },
    {
      "name": "account_credential",
      "policy": "account",
      "sensitivity": 3,
      "replacement": "账号密码",
      "keywords": ["密码", "登录密码", "支付密码", "验证码", "动态码", "私钥", "密钥", "助记词", "口令", "登录码", "password"],
      "patterns": [
        "(?<![A-Za-z0-9_])(?:token|secret|cookies?|api_key|apikey)(?![A-Za-z0-9_])\\s*[=:]\\s*(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s，。；;\"'“”‘’<>]+)"
      ],
      "keyword_patterns": ["{{keyword}}[是为:=\\s]+(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|“[^”\\r\\n]+”|[^\\s，。；;\"'“”‘’<>]+)"]
    },
    {
      "name": "bank_account",
      "policy": "account",
      "sensitivity": 3,
      "replacement": "那张卡",
      "keywords": ["银行卡", "银行卡号", "信用卡", "信用卡号", "卡号", "开户行"],
      "patterns": [],
      "keyword_patterns": ["{{keyword}}[是为:=\\s]*(?:\\d[ -]?){6,30}"]
    },
    {
      "name": "account_identifier",
      "policy": "account",
